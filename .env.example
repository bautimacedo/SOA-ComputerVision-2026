DATABASE_URL=postgresql://soa:soa@db:5432/soatp

AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=soa-frames

MODELS_DIR=/app/models
BASE_URL=http://localhost:8000
INFERENCE_SERVICE_URL=http://100.x.x.x:8001

# Keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak — cliente HTTP del backend hacia Keycloak
# http://keycloak:8080 porque el backend corre containerizado y se comunica con
# Keycloak por la red interna de Docker (nombre del servicio), no por localhost.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=soa-realm
KEYCLOAK_CLIENT_ID=soa-client
KEYCLOAK_CLIENT_SECRET=changeme

# Hostname público que Keycloak usa para generar URLs/issuer (KC_HOSTNAME).
# En local: localhost. En la VPS: el subdominio real, sin esquema ni puerto.
KEYCLOAK_HOSTNAME=localhost

# URL pública de Keycloak — la usa el NAVEGADOR (ej. al loguearse en Grafana),
# a diferencia de KEYCLOAK_URL que es para llamadas servidor-a-servidor.
# En la VPS: https://auth.soagmr.mooo.com (detrás de nginx, con TLS).
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Grafana — login vía Keycloak (Authorization Code Flow, client "grafana-client")
GRAFANA_KEYCLOAK_CLIENT_SECRET=changeme

# Grafana — URL pública (la pisa el navegador al loguearse). En la VPS, detrás de
# nginx en /grafana/. En local (sin nginx) usar http://localhost:3000/ y "false".
GRAFANA_ROOT_URL=https://soagmr.mooo.com/grafana/
GRAFANA_SERVE_FROM_SUB_PATH=true
